{
  "version": 2,
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/products/?",
      "dest": "/products/index.html"
    },
    {
      "src": "/industries/?",
      "dest": "/industries/index.html"
    },
    {
      "src": "/about/?",
      "dest": "/about/index.html"
    },
    {
      "src": "/contact/?",
      "dest": "/contact/index.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
